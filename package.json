{
  "name": "pkgviz",
  "bin": {
    "pkgviz": "bin/pkgviz.ts"
  },
  "files": [
    "/bin",
    "/src",
    "tsconfig.json",
    ".next"
  ],
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.2.18",
    "npm": ">=10.9.2"
  },
  "version": "0.7.7",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "docs:deploy": "bun --filter forensics-docs run deploy",
    "start": "next start",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "format:check": "ankhorage-prettier --check .",
    "format:write": "ankhorage-prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml,mjs,cjs,html,css,scss,mdx}\"",
    "test": "npx @artiphishle/testosterone@0.3.1",
    "test:cov": "c8 --reporter=text --reporter=text-summary tsx --test",
    "test:cov:html": "c8 --report-dir=./test/coverage --reporter=html tsx --test",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "knip:check": "ankhorage-knip",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version"
  },
  "dependencies": {
    "@ankhorage/project-detector": "^0.1.0",
    "@artiphishle/testosterone": "^0.3.1",
    "cytoscape": "^3.33.1",
    "cytoscape-elk": "^2.3.0",
    "lucide-react": "^0.487.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.16.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/bun": "^1.4.1",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "c8": "^10.1.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6"
  },
  "packageManager": "bun@1.4.2"
}
