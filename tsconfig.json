{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "app/*": [
        "./app/*"
      ],
      "@zora/tree-view": [
        "./.generated/zora/tree-view/TreeView"
      ],
      "@zora/graph-view": [
        "./.generated/zora/graph-view/GraphView"
      ],
      "@zora/activity-indicator": [
        "./.generated/zora/activity-indicator/ActivityIndicator"
      ],
      "@zora/app-bar": [
        "./.generated/zora/app-bar/AppBar"
      ],
      "@zora/badge": [
        "./.generated/zora/badge/Badge"
      ],
      "@zora/breadcrumbs": [
        "./.generated/zora/breadcrumbs/Breadcrumbs"
      ],
      "@zora/button": [
        "./.generated/zora/button/Button"
      ],
      "@zora/card": [
        "./.generated/zora/card/Card"
      ],
      "@zora/select": [
        "./.generated/zora/select/Select"
      ],
      "@zora/surface": [
        "./.generated/zora/surface/Surface"
      ],
      "@zora/switch": [
        "./.generated/zora/switch/Switch"
      ],
      "@zora/tabs": [
        "./.generated/zora/tabs/Tabs"
      ],
      "@zora/text": [
        "./.generated/zora/text/Text"
      ],
      "@zora/view": [
        "./.generated/zora/view/View"
      ]
    },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples"
  ]
}
